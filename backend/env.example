# Server Configuration
PORT=3000

# Admin Credentials (CHANGE IN PRODUCTION)
ADMIN_EMAIL=admin@capitalreclaim.com
ADMIN_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# JWT Secret (REQUIRED in production - Use a strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# Security Configuration
# CORS: Comma-separated list of allowed origins (e.g., "https://example.com,https://www.example.com")
# Leave empty in production to block all cross-origin requests
ALLOWED_ORIGINS=

# Proxy Configuration (only if behind a reverse proxy)
# Set to "true" to trust all proxies (development only - NOT recommended)
TRUST_PROXY=false
# Comma-separated list of trusted proxy IPs (recommended for production)
TRUSTED_PROXY_IPS=

# Email Configuration - cPanel/Domain Email (Primary Method)
# Use your domain email account (e.g., noreply@aesusinvestigators.com)
EMAIL_USER=noreply@aesusinvestigators.com
EMAIL_PASSWORD=your-email-password

# SMTP Settings for cPanel
SMTP_HOST=mail.aesusinvestigators.com
SMTP_PORT=587
SMTP_SECURE=false
# Alternative: use port 465 with SMTP_SECURE=true for SSL

# Data Retention Policy (GDPR Compliance)
# Retention period in days - cases older than this will be automatically deleted
DATA_RETENTION_DAYS=2555  # 7 years (default)
COMPLETED_CASE_RETENTION_DAYS=1095  # 3 years for completed cases

# Backup Configuration
BACKUP_RETENTION_DAYS=30  # Keep backups for 30 days

# Error Tracking
# Error logs are automatically cleaned after 30 days

# Microsoft 365 / Graph OAuth (Delegated or Application)
# Required for Graph-based sending. For delegated, redirect URI must be registered in Azure AD app.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_TENANT_ID=
OAUTH_REDIRECT_URI=http://localhost:3000/api/ms/callback

# Default From address (should match EMAIL_USER domain)
DEFAULT_EMAIL_FROM=noreply@aesusinvestigators.com
